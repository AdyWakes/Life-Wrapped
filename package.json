{
  "name": "lifewrapped",
  "private": true,
  "version": "0.1.0",
  "description": "Your year in chats, wrapped. Spotify Wrapped-style story from your own WhatsApp & Instagram exports. 100% in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
